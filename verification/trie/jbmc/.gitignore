# Regenerated by run-jbmc.sh (build/ is ignored one level up). Per-run JBMC output is hundreds of MB:
# the committed record of every run is results/summary.json (verdict, exact command, failed
# properties, bounds, stubs, host, limits) plus results/invocation-manifest.json.
__pycache__/
results/*.log
results/*.stubs.txt
results/local-run.out
results/pending-local.txt
results/key-family.txt
results/summary.json.tmp
results/summary.json.lock
results/rerun-old.txt
